{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-ground.dev/schemas/meta.schema.json",
  "title": "Solid Ground dataset meta",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedAt",
    "lastSuccessfulCollect",
    "lastSuccessfulVerify",
    "solid",
    "counts",
    "versions",
    "coverage",
    "anomaly"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time", "maxLength": 40 },
    "lastSuccessfulCollect": {
      "type": ["string", "null"],
      "format": "date-time",
      "maxLength": 40
    },
    "lastSuccessfulVerify": {
      "type": ["string", "null"],
      "format": "date-time",
      "maxLength": 40
    },
    "solid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable2", "next", "observedAt"],
      "properties": {
        "stable2": { "type": "string", "minLength": 1, "maxLength": 120 },
        "next": { "type": ["string", "null"], "maxLength": 120 },
        "observedAt": { "type": "string", "format": "date-time", "maxLength": 40 }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "prerelease",
        "in-progress",
        "blocked",
        "unmaintained",
        "agnostic",
        "unknown",
        "total"
      ],
      "properties": {
        "ready": { "type": "integer", "minimum": 0 },
        "prerelease": { "type": "integer", "minimum": 0 },
        "in-progress": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "unmaintained": { "type": "integer", "minimum": 0 },
        "agnostic": { "type": "integer", "minimum": 0 },
        "unknown": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rules", "tool", "schema"],
      "properties": {
        "rules": { "type": "string", "minLength": 1, "maxLength": 40 },
        "tool": { "type": "string", "minLength": 1, "maxLength": 40 },
        "schema": { "type": "integer", "minimum": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tracked", "curated", "candidates"],
      "properties": {
        "tracked": { "type": "integer", "minimum": 0 },
        "curated": { "type": "integer", "minimum": 0 },
        "candidates": { "type": "integer", "minimum": 0 }
      }
    },
    "anomaly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["held", "reasons"],
      "properties": {
        "held": { "type": "boolean" },
        "reasons": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "maxLength": 600 }
        }
      }
    }
  }
}
