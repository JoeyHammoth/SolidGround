{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://solid-ground.dev/schemas/controls.schema.json",
  "title": "Solid Ground control history",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "streak", "required", "remaining", "auditMet", "lastRun", "days"],
  "properties": {
    "$schema": { "type": "string", "format": "uri", "maxLength": 200 },
    "schemaVersion": { "const": 1 },
    "streak": { "type": "integer", "minimum": 0 },
    "required": { "type": "integer", "minimum": 0 },
    "remaining": { "type": "integer", "minimum": 0 },
    "auditMet": { "type": "boolean" },
    "lastRun": {
      "type": ["string", "null"],
      "format": "date-time",
      "maxLength": 40
    },
    "days": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day", "clean", "runs", "at", "failures", "groups"],
        "properties": {
          "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "clean": { "type": "boolean" },
          "runs": { "type": "integer", "minimum": 0 },
          "at": { "type": "string", "format": "date-time", "maxLength": 40 },
          "failures": { "type": "integer", "minimum": 0 },
          "groups": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["subject", "details"],
              "properties": {
                "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
                "details": {
                  "type": "array",
                  "maxItems": 100,
                  "items": { "type": "string", "maxLength": 600 }
                }
              }
            }
          }
        }
      }
    }
  }
}
