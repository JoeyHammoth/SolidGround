---
import Base from "../layouts/Base.astro";
import { AUDIT_DAYS } from "@solid-ground/smoke/status";
import {
  consistencyProblems,
  controls,
  deployValidation,
  index,
  meta,
  records,
  relativeAge,
} from "../lib/data";
import { groupControlFailures } from "@solid-ground/smoke/status";
import { validationTargetLabels } from "../lib/validation.js";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const stale = Date.now() - new Date(meta.generatedAt).getTime() > 72 * 3600 * 1000;
const oldest = [...records].sort((a, b) => a.checkedAt.localeCompare(b.checkedAt))[0];
const controlDays = controls.days.slice(-14);
const failedDays = controlDays.filter((day) => !day.clean);
const lastControlDay = controls.days.at(-1);
const remaining = Math.max(0, AUDIT_DAYS - controls.streak);
---

<Base title="Health" description="Freshness, coverage and provenance of the Solid Ground dataset.">
  <h1>Health</h1>
  <p class="lede">Trustworthy dates are the product. This page makes automation failures visible instead of hiding them.</p>

  {stale && <div class="banner" role="status">No successful dataset generation in the last 72 hours. Treat statuses as stale until the next run.</div>}

  <div class="grid cols-3">
    <div class="card"><div class="stat">{relativeAge(meta.generatedAt)}</div><div class="stat-label">Dataset age</div></div>
    <div class="card"><div class="stat">{meta.coverage.tracked}</div><div class="stat-label">Tracked packages</div></div>
    <div class="card"><div class="stat">{meta.coverage.candidates}</div><div class="stat-label">Candidates awaiting review</div></div>
  </div>

  <h2>Versions and provenance</h2>
  <ul>
    <li>Solid stable tested: <code>{meta.solid.stable2}</code>{meta.solid.next ? <>; next: <code>{meta.solid.next}</code></> : null}</li>
    <li>Observed at <code>{meta.solid.observedAt}</code></li>
    <li>Rules <code>{meta.versions.rules}</code> · tool <code>{meta.versions.tool}</code> · schema <code>{meta.versions.schema}</code></li>
    <li>Oldest record checked: <code>{oldest?.checkedAt ?? "none"}</code>{oldest ? ` (${oldest.name})` : ""}</li>
    <li>Last successful collect: <code>{meta.lastSuccessfulCollect ?? "never"}</code></li>
    <li>Last successful verify: <code>{meta.lastSuccessfulVerify ?? "not run yet"}</code></li>
  </ul>

  <h2>Dataset validation</h2>
  <p>
    Full schema validation:{" "}
    {deployValidation ? (
      <span>
        <strong>{deployValidation.ok ? "passed" : "failed"}</strong>
        {deployValidation.checkedAt && ` at ${deployValidation.checkedAt}`}
        {deployValidation.targets.length > 0 &&
          ` over ${validationTargetLabels(deployValidation.targets).join(", ")}`}{" "}
        ({deployValidation.problems.length} problem(s)).
      </span>
    ) : (
      <span>
        <strong>not recorded</strong> in this build. The deploy runs{" "}
        <code>pnpm validate</code> before building, so a page published from the
        data branch has passed it.
      </span>
    )}
  </p>
  <p>
    Consistency checks at build over {records.length} records, {index.length} index rows and {controls.days.length} control day(s):
    <strong>{consistencyProblems.length === 0 ? "valid" : `${consistencyProblems.length} problem(s)`}</strong>.
  </p>
  {deployValidation && deployValidation.problems.length > 0 && (
    <ul>
      {deployValidation.problems.slice(0, 8).map((problem) => <li><code>{problem}</code></li>)}
      {deployValidation.problems.length > 8 && <li>…and {deployValidation.problems.length - 8} more</li>}
    </ul>
  )}
  {consistencyProblems.length > 0 && (
    <ul>
      {consistencyProblems.slice(0, 8).map((problem) => <li><code>{problem}</code></li>)}
      {consistencyProblems.length > 8 && <li>…and {consistencyProblems.length - 8} more</li>}
    </ul>
  )}

  <h2>Smoke controls</h2>
  <p>
    The sandboxed matrix runs a known-good fixture, a known-bad fixture and a subpath-only fixture in
    every batch. A batch whose controls answer wrongly is discarded, so these verdicts are the evidence
    that a package result can be trusted. Two weeks of clean control days is the gate for letting the
    matrix change a record.
  </p>
  {lastControlDay && !lastControlDay.clean && (
    <div class="banner" role="status">A control run on the newest day did not answer as expected; that batch was discarded. The last successful run is listed below.</div>
  )}
  {controlDays.length > 0 ? (
    <>
      <p>
        {controls.streak} clean day(s) in a row from {controls.days.length} recorded; last run
        <code>{controls.lastRun}</code>. Audit gate: <strong>{controls.auditMet ? "met" : `not met — ${remaining} more clean day(s) needed`}</strong>.
      </p>
      <p class="small muted">Legend: ✓ clean day · ✕ failed day · one cell per UTC day, oldest first.</p>
      <ol class="gate-timeline" aria-label={`Last ${controlDays.length} control day(s), oldest first`}>
        {controlDays.map((day) => (
          <li
            class={`gate-day ${day.clean ? "clean" : "failed"}`}
            aria-label={`${day.day}: ${day.clean ? "clean" : `failed, ${day.failures.length} failure(s)`}, ${day.runs} control result(s)`}
            title={`${day.day}: ${day.clean ? "clean" : `failed, ${day.failures.length} failure(s)`}, ${day.runs} control result(s)`}
          >
            <span class="gate-day-mark" aria-hidden="true">{day.clean ? "✓" : "✕"}</span>
            <time datetime={day.day}>{day.day.slice(5)}</time>
            <span class="small"> {day.clean ? "clean" : "failed"}</span>
            {!day.clean && <span class="gate-day-count" aria-hidden="true">{day.failures.length}</span>}
          </li>
        ))}
      </ol>
      {failedDays.length > 0 && (
        <details class="gate-failures">
          <summary>Why {failedDays.length} control day(s) failed</summary>
          <ul>
            {failedDays.map((day) => (
              <li>
                <code>{day.day}</code> — {day.failures.length} failure(s)
                <ul>
                  {groupControlFailures(day.failures).map((group) => (
                    <li><strong>{group.subject}</strong>: {group.details.join("; ")}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ul>
        </details>
      )}
    </>
  ) : (
    <p class="muted">No control runs recorded yet; {AUDIT_DAYS} clean days are needed before the matrix can change a record.</p>
  )}

  <h2>Anomaly gate</h2>
  <p>
    A run that would change more than 5% of statuses, or drop more than 10% of records, is held for
    human review rather than published. A new Solid release also gets a human look at the first diff.
    Current state: <strong>{meta.anomaly.held ? "held" : "clear"}</strong>.
  </p>
  <ul>{meta.anomaly.reasons.map((reason) => <li>{reason}</li>)}</ul>

  <h2>Coverage statement</h2>
  <p>
    Tracking {meta.coverage.tracked} packages ({meta.coverage.curated} curated). Discovery is not
    exhaustive; a package that peers on <code>solid-js</code> can still be missing.
    <a href="https://github.com/JoeyHammoth/SolidGround/issues/new?template=add-package.yml">Request an addition</a>.
  </p>

  <p class="small muted">Machine-readable health: <a href={`${base}/api/v1/meta.json`}><code>meta.json</code></a> · <a href={`${base}/api/v1/solid.json`}><code>solid.json</code></a> · <a href={`${base}/api/v1/gate.json`}><code>gate.json</code></a> · <a href={`${base}/api/v1/validation.json`}><code>validation.json</code></a></p>
</Base>
