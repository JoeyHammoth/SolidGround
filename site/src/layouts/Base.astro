---
import { AUDIT_DAYS } from "@solid-ground/smoke/status";
import { controls } from "../lib/data";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Know what's solid before you upgrade: SolidJS 2 ecosystem readiness with evidence and dates." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const remaining = Math.max(0, AUDIT_DAYS - controls.streak);
const here = Astro.url.pathname.replace(base, "") || "/";
const nav = [
  { href: "/", label: "Overview" },
  { href: "/packages/", label: "Packages" },
  { href: "/check/", label: "Check my app" },
  { href: "/health/", label: "Health" },
  { href: "/changes/", label: "Changes" },
  { href: "/methodology/", label: "Methodology" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0b1020" />
    <link rel="icon" type="image/svg+xml" href={`${base}/assets/logo.svg`} />
    <link
      rel="alternate"
      type="application/atom+xml"
      title="Solid Ground — changes"
      href={`${base}/feed.xml`}
    />
    <title>{title} · Solid Ground</title>
    <style is:global>
      :root {
        color-scheme: dark light;
        --bg: #070b16;
        --bg-soft: #0d1425;
        --panel: #111a2e;
        --panel-2: #16213a;
        --text: #e8eefc;
        --muted: #96a3c2;
        --line: #243252;
        --teal: #2dd4bf;
        --indigo: #818cf8;
        --green: #34d399;
        --amber: #fbbf24;
        --red: #f87171;
        --grey: #94a3b8;
        --radius: 14px;
        --max: 1120px;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Inter, sans-serif;
      }
      html { background: var(--bg); scroll-behavior: smooth; }
      body {
        margin: 0;
        color: var(--text);
        background:
          radial-gradient(900px 500px at 15% -10%, rgba(45, 212, 191, 0.16), transparent 60%),
          radial-gradient(800px 500px at 90% 0%, rgba(129, 140, 248, 0.16), transparent 55%),
          var(--bg);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--teal); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      :focus-visible { outline: 3px solid var(--indigo); outline-offset: 2px; border-radius: 6px; }
      .wrap { max-width: var(--max); margin: 0 auto; padding: 0 24px; }
      header.site { border-bottom: 1px solid var(--line); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 10; background: rgba(7, 11, 22, 0.82); }
      header.site .wrap { display: flex; align-items: center; gap: 18px; min-height: 64px; flex-wrap: wrap; }
      .brand { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; letter-spacing: -0.02em; color: var(--text); }
      .brand img { width: 30px; height: 30px; }
      nav.main { display: flex; gap: 4px; flex-wrap: wrap; margin-left: auto; }
      nav.main a { padding: 6px 10px; border-radius: 999px; color: var(--muted); font-size: 0.9rem; }
      nav.main a[aria-current="page"], nav.main a:hover { color: var(--text); background: rgba(129, 140, 248, 0.14); text-decoration: none; }
      main { padding: 48px 0 72px; }
      h1 { font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.08; letter-spacing: -0.035em; margin: 0 0 12px; }
      h2 { font-size: clamp(1.35rem, 2.4vw, 1.75rem); letter-spacing: -0.02em; margin: 44px 0 14px; }
      h3 { margin: 26px 0 8px; }
      p, li { color: var(--muted); }
      strong { color: var(--text); }
      code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.92em; background: var(--panel-2); border: 1px solid var(--line); padding: 1px 5px; border-radius: 5px; color: #d7e0f7; }
      pre { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 16px; overflow-x: auto; }
      pre code { background: none; border: 0; padding: 0; }
      .lede { font-size: 1.12rem; max-width: 60ch; }
      .muted { color: var(--muted); }
      .small { font-size: 0.85rem; }
      .pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border: 1px solid var(--line); border-radius: 999px; font-size: 0.78rem; color: var(--muted); background: var(--bg-soft); }
      .gate { text-decoration: none; }
      .gate:hover { color: var(--text); border-color: var(--teal); text-decoration: none; }
      .btn { display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px; border-radius: 999px; font-weight: 600; border: 1px solid var(--line); background: var(--panel); color: var(--text); }
      .btn.primary { background: linear-gradient(135deg, var(--teal), var(--indigo)); color: #06101f; border: 0; }
      .btn:hover { text-decoration: none; transform: translateY(-1px); }
      .grid { display: grid; gap: 16px; }
      .cols-3 { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
      .cols-2 { grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
      .card { background: linear-gradient(180deg, var(--panel), var(--bg-soft)); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; }
      .card h3 { margin-top: 0; }
      .stat { font-size: 2rem; font-weight: 750; letter-spacing: -0.03em; color: var(--text); }
      .stat-label { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
      .status { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 0.84rem; padding: 3px 9px; border-radius: 999px; border: 1px solid var(--line); white-space: nowrap; }
      .status-ready { color: #062c22; background: var(--green); border-color: transparent; }
      .status-prerelease { color: #0b1633; background: #93c5fd; border-color: transparent; }
      .status-in-progress { color: #2b1c02; background: var(--amber); border-color: transparent; }
      .status-blocked { color: #2c0606; background: var(--red); border-color: transparent; }
      .status-unmaintained { color: #111827; background: var(--grey); border-color: transparent; }
      .status-agnostic { color: #111827; background: #cbd5e1; border-color: transparent; }
      .status-unknown { color: #2b1c02; background: #fdba74; border-color: transparent; }
      table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
      th { text-align: left; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); padding: 10px 12px; border-bottom: 1px solid var(--line); }
      td { padding: 11px 12px; border-bottom: 1px solid var(--line); vertical-align: middle; }
      tbody tr:hover { background: rgba(129, 140, 248, 0.06); }
      .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
      .filters { display: flex; gap: 10px; flex-wrap: wrap; margin: 18px 0; }
      input[type="search"], select, textarea {
        background: var(--bg-soft); color: var(--text); border: 1px solid var(--line);
        border-radius: 10px; padding: 9px 12px; font: inherit;
      }
      textarea { width: 100%; min-height: 180px; font-family: ui-monospace, monospace; font-size: 0.9rem; }
      .evidence { display: inline-flex; gap: 3px; font-family: ui-monospace, monospace; font-size: 0.78rem; }
      .evidence span { border: 1px solid var(--line); border-radius: 4px; padding: 0 4px; color: var(--muted); }
      .evidence span.on { color: #06101f; background: var(--teal); border-color: transparent; font-weight: 700; }
      .banner { border: 1px solid #7c5a12; background: rgba(251, 191, 36, 0.12); color: #fde68a; padding: 12px 16px; border-radius: 10px; margin-bottom: 20px; }
      .hero { display: grid; grid-template-columns: 1.6fr 1fr; gap: 32px; align-items: center; }
      .hero img { width: 100%; max-width: 280px; justify-self: end; filter: drop-shadow(0 24px 40px rgba(45, 212, 191, 0.18)); }
      .verdict { font-size: 1.05rem; color: var(--text); border-left: 3px solid var(--teal); padding-left: 14px; }
      footer.site { border-top: 1px solid var(--line); padding: 28px 0 40px; color: var(--muted); font-size: 0.86rem; }
      footer.site .wrap { display: flex; gap: 18px; flex-wrap: wrap; justify-content: space-between; }
      @media (max-width: 760px) {
        .hero { grid-template-columns: 1fr; }
        .hero img { justify-self: start; max-width: 200px; }
        main { padding-top: 32px; }
      }
      @media (prefers-reduced-motion: reduce) {
        * { animation: none !important; transition: none !important; }
      }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>
          <img src={`${base}/assets/logo.svg`} alt="" width="30" height="30" />
          Solid Ground
        </a>
        <a
          class="pill gate"
          href={`${base}/health/`}
          title={controls.auditMet
            ? "The two-week control gate is met; new passes may publish"
            : `${remaining} more clean control day(s) before new smoke passes publish`}
        >
          {controls.auditMet ? "Smoke gate met" : `Smoke gate ${controls.streak}/${AUDIT_DAYS}`}
        </a>
        <nav class="main" aria-label="Main">
          {nav.map((item) => (
            <a href={`${base}${item.href}`} aria-current={here === item.href ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="wrap">
        <span>
          Community project, not affiliated with the SolidJS team. Data CC BY 4.0, code MIT.
        </span>
        <span>
          <a href="https://github.com/JoeyHammoth/SolidGround">GitHub</a> ·
          <a href={`${base}/api/v1/index.json`}>JSON API</a> ·
          <a href={`${base}/methodology/`}>Methodology</a>
        </span>
      </div>
    </footer>
  </body>
</html>
