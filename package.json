{
  "name": "solid-ground",
  "version": "0.1.0",
  "private": true,
  "description": "SolidJS 2.0 ecosystem readiness tracker: an evidence-based, open dataset and dashboard.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "pnpm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "tsx packages/schema/src/cli.ts",
    "dataset": "tsx packages/collector/src/cli.ts",
    "site:dev": "pnpm --filter @solid-ground/site dev",
    "site:build": "pnpm --filter @solid-ground/site build",
    "check:app": "tsx packages/cli/src/index.ts check",
    "check:live": "tsx packages/cli/src/live-api.ts",
    "sentinel": "tsx packages/collector/src/sentinel.ts",
    "smoke:plan": "tsx packages/smoke/src/cli.ts plan",
    "smoke:report": "tsx packages/smoke/src/cli.ts report",
    "smoke:publish": "tsx packages/smoke/src/cli.ts publish",
    "smoke:status": "tsx packages/smoke/src/cli.ts status",
    "smoke:compact": "tsx packages/smoke/src/cli.ts compact",
    "smoke:fixture": "tsx packages/smoke/src/cli.ts fixture",
    "smoke:gate": "tsx packages/smoke/src/cli.ts gate",
    "smoke:run": "tsx packages/smoke/src/runner.ts",
    "audit:blocked": "tsx packages/cli/src/blocked.ts",
    "audit:issue": "tsx packages/cli/src/audit-issue.ts",
    "api:issue": "tsx packages/cli/src/api-issue.ts",
    "scan": "tsx packages/scanner/src/cli.ts",
    "eval:scanner": "tsx packages/scanner/eval/run.ts",
    "ci": "pnpm run lint && pnpm run test && pnpm run validate registry fixtures && pnpm run site:build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/semver": "^7.5.8",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "es-module-lexer": "^3.0.5",
    "prettier": "^3.4.2",
    "semver": "^7.6.3",
    "tar": "^7.4.3",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "yaml": "^2.6.1"
  }
}
